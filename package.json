{
  "name": "gptimage2-vue-clone",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite-ssg build && node scripts/generate-sitemap.mjs",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "preview": "vite preview --host 0.0.0.0",
    "sync:prompt-library": "node scripts/sync-prompt-library.mjs",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:a11y": "playwright test e2e/a11y.spec.js",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test e2e/smoke.spec.js",
    "test:unit": "vitest run",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "bundle:analyze": "vite-ssg build --mode analyze && node scripts/generate-sitemap.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm test:unit && pnpm build && pnpm bundle:check"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "lucide-vue-next": "^0.468.0",
    "vite": "^7.1.12",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "web-vitals": "^5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@unhead/vue": "^1.11.0",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.3.0",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.1.6"
  }
}
